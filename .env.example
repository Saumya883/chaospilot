# TinyFish (add later)
TINYFISH_API_KEY=

# LLM planner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database (Supabase / Postgres)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Safety limits
MAX_STEPS_PER_SCENARIO=25
STAGING_ONLY=true
# Which runner to use: mock (fake, labelled SIMULATED) or tinyfish (real browser)
RUNNER=mock

# Only sites listed here can be tested. Add a host only if you own it or have written permission.
ALLOWED_HOSTS=localhost,127.0.0.1
